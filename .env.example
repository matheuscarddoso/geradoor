# Postgres local (Homebrew postgresql@16)
DATABASE_URL=""

# Painel admin (/admin) — troque antes de qualquer deploy
ADMIN_USER=""
ADMIN_PASS=""
ADMIN_TOKEN=""

# Gerador de código de barras (/codigo-de-barras) — uso interno, atrás de senha
# GRAFICA_PASS: a senha que o operador digita
# GRAFICA_TOKEN: chave de assinatura do cookie, nunca sai do servidor
#   gere com: openssl rand -base64 48
GRAFICA_PASS=""
GRAFICA_TOKEN=""

# Removedor de fundo (/removedor-de-fundo) — opcional
# Endereço do Worker da Cloudflare que faz o recorte. Sem a variável, vale o
# deploy de produção fixado em src/lib/removedorDeFundo.ts. Não é segredo, e
# por ser NEXT_PUBLIC_ entra no bundle no build. Ver docs/removedor-de-fundo.md
# e workers/removedor-de-fundo/README.md.
# NEXT_PUBLIC_REMOVEDOR_URL="https://geradoor-removedor-de-fundo.mathuscardoso.workers.dev/"
